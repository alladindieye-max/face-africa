# Supabase project settings. Use the public anon/publishable key only in client-safe contexts.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Server-only key; never expose it in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
# Configure only after creating merchant credentials and reviewing provider docs.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# Optional email provider; without this, notifications remain in-app only.
EMAIL_PROVIDER_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
